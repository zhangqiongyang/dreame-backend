# 复制为 .env 后填写：cp .env.example .env

# MySQL（容器内自动创建 dreame 库与用户）
MYSQL_ROOT_PASSWORD=请设置强密码
MYSQL_PASSWORD=请设置强密码

# 站点（单域名）
PUBLIC_BASE_URL=https://cuteyam.com
CORS_ORIGINS=https://cuteyam.com,https://www.cuteyam.com

# 生产务必 false
DEBUG=false

# 微信（须与 dreame-web-mini manifest appid 一致）
WECHAT_APPID=wx你的AppID
WECHAT_SECRET=你的AppSecret
WECHAT_MOCK=false

# 安全（生产务必修改）
JWT_SECRET=请设置至少32位随机字符串
ADMIN_USERNAME=admin
ADMIN_PASSWORD=请设置强密码
ADMIN_DISPLAY_NAME=管理员
