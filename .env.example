APP_NAME=Dreame API
DEBUG=true

DATABASE_URL=mysql+aiomysql://dreame:dreame@127.0.0.1:3306/dreame?charset=utf8mb4
DATABASE_URL_SYNC=mysql+pymysql://dreame:dreame@127.0.0.1:3306/dreame?charset=utf8mb4

# 微信（留空则 WECHAT_MOCK=true，用 code 模拟 openid）
WECHAT_APPID=
WECHAT_SECRET=
WECHAT_MOCK=true

JWT_SECRET=change-me-in-production
JWT_EXPIRE_SECONDS=604800

# 管理后台（登录账号 + 兼容旧版固定 Token）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ADMIN_DISPLAY_NAME=Admin User
ADMIN_TOKEN=dreame-admin-dev

ORDER_EXPIRE_HOURS=24
AUTO_COMPLETE_SHIPPED_DAYS=7

CORS_ORIGINS=*
