APP_NAME=Dreame API
DEBUG=true

# 异步连接（应用运行时）
# Docker Compose 本仓库默认：mysql+aiomysql://dreame:dreame@127.0.0.1:3306/dreame?charset=utf8mb4
DATABASE_URL=mysql+aiomysql://dreame:dreame@127.0.0.1:3306/dreame?charset=utf8mb4

# Alembic 迁移用（同步驱动）；可与 DATABASE_URL 并存
DATABASE_URL_SYNC=mysql+pymysql://dreame:dreame@127.0.0.1:3306/dreame?charset=utf8mb4
